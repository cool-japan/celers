    },
    {
      "value": {
        "n": 1.0,
        "m": 2.5
      },
      "repr": "{'m': 2.5, 'n': 1.0}"
    },
    {
      "value": {
        "quote": "it's"
      },
      "repr": "{'quote': 'it\\'s'}"
    },
    {
      "value": {
